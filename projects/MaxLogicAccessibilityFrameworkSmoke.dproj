<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{CBE54487-8418-4B42-B79F-62088C35132A}</ProjectGuid>
    <ProjectVersion>20.3</ProjectVersion>
    <MainSource>MaxLogicAccessibilityFrameworkSmoke.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <TargetedPlatforms>3</TargetedPlatforms>
    <AppType>Console</AppType>
    <FrameworkType>VCL</FrameworkType>
    <AppDPIAwarenessMode>PerMonitorV2</AppDPIAwarenessMode>
    <Manifest_File>$(BDS)\bin\default_app.manifest</Manifest_File>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
    <Base_Win32>true</Base_Win32>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Base)'=='true') or '$(Base_Win64)'!=''">
    <Base_Win64>true</Base_Win64>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_1)'!=''">
    <Cfg_1>true</Cfg_1>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_2)'!=''">
    <Cfg_2>true</Cfg_2>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base)'!=''">
    <DCC_ExeOutput>..\bin\$(Platform)\$(Config)</DCC_ExeOutput>
    <DCC_DcuOutput>..\dcu\$(MSBuildProjectName)\$(Platform)\$(Config)</DCC_DcuOutput>
    <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Vcl;Winapi;$(DCC_Namespace)</DCC_Namespace>
    <DCC_UnitSearchPath>..\src;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_UsePackage>rtl;vcl;$(DCC_UsePackage)</DCC_UsePackage>
    <DCC_Warnings>True</DCC_Warnings>
    <DCC_Hints>True</DCC_Hints>
    <DCC_ImageBase>00400000</DCC_ImageBase>
    <VerInfo_MajorVer>0</VerInfo_MajorVer>
    <VerInfo_MinorVer>1</VerInfo_MinorVer>
    <VerInfo_Release>0</VerInfo_Release>
    <VerInfo_Build>0</VerInfo_Build>
    <VerInfo_Keys>CompanyName=MaxLogic;FileDescription=MaxLogic Accessibility Framework Smoke;FileVersion=0.1.0.0;InternalName=MaxLogicAccessibilityFrameworkSmoke;LegalCopyright=;OriginalFilename=MaxLogicAccessibilityFrameworkSmoke.exe;ProductName=MaxLogic Accessibility Framework;ProductVersion=0.1.0.0</VerInfo_Keys>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base_Win32)'!=''">
    <DCC_Namespace>Winapi;System.Win;Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;Bde;$(DCC_Namespace)</DCC_Namespace>
    <AppDPIAwarenessMode>PerMonitorV2</AppDPIAwarenessMode>
    <Manifest_File>$(BDS)\bin\default_app.manifest</Manifest_File>
    <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base_Win64)'!=''">
    <DCC_Namespace>Winapi;System.Win;Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;$(DCC_Namespace)</DCC_Namespace>
    <AppDPIAwarenessMode>PerMonitorV2</AppDPIAwarenessMode>
    <Manifest_File>$(BDS)\bin\default_app.manifest</Manifest_File>
    <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_1)'!=''">
    <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
    <DCC_DebugInformation>false</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
    <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
    <DCC_Optimize>true</DCC_Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_2)'!=''">
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
    <DCC_DebugInformation>1</DCC_DebugInformation>
    <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
    <DCC_Optimize>false</DCC_Optimize>
    <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
    <DCC_RangeChecking>true</DCC_RangeChecking>
    <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="..\src\MaxLogic.Accessibility.Framework.pas"/>
    <DCCReference Include="..\src\MaxLogic.Accessibility.Hints.pas"/>
    <DCCReference Include="..\src\MaxLogic.Accessibility.Manager.pas"/>
    <DCCReference Include="..\src\MaxLogic.Accessibility.ProviderCore.pas"/>
    <DCCReference Include="..\src\MaxLogic.Accessibility.Scanner.pas"/>
    <DCCReference Include="..\src\MaxLogic.Accessibility.TmsAdvStringGridAdapters.pas"/>
    <DCCReference Include="..\src\MaxLogic.Accessibility.Text.pas"/>
    <DCCReference Include="..\src\MaxLogic.Accessibility.UIAutomationCore.pas"/>
    <DCCReference Include="..\src\MaxLogic.Accessibility.VclAdapters.pas"/>
    <BuildConfiguration Include="Base">
      <Key>Base</Key>
    </BuildConfiguration>
    <BuildConfiguration Include="Release">
      <Key>Cfg_1</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
    <BuildConfiguration Include="Debug">
      <Key>Cfg_2</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <Borland.ProjectType/>
    <BorlandProject>
      <Delphi.Personality>
        <Source>
          <Source Name="MainSource">MaxLogicAccessibilityFrameworkSmoke.dpr</Source>
        </Source>
      </Delphi.Personality>
      <Platforms>
        <Platform value="Win32">True</Platform>
        <Platform value="Win64">True</Platform>
      </Platforms>
    </BorlandProject>
    <ProjectFileVersion>12</ProjectFileVersion>
  </ProjectExtensions>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
